  "claims": [
    {
      "id": "claim_4c795f76e034493bb86353025c094695",
      "statement": "The placebo construction workflow is implemented entirely in /lib/create/event_study_sample.do, which is invoked with two arguments: <variation> (from analysis-sample filters) and <sample> (CEO transition type filter).",
      "evidence": [
        {
          "resource": "repo://lib/create/event_study_sample.do#L1-L247",
          "version": "repo-lines-v1:sha256:96de0c99a8e1545f402e88fc8fca35d844a7a01737774a348b82fc8523035016:"
        }
      ]
    },
    {
      "id": "claim_c87d39c98e2a4bb4b7180e5c6c662f0d",
      "statement": "The exact matching strata for placebo construction are defined by global exact_match_on = cohort sector max_size: every control firm must match a treated firm on founding-year cohort, industry sector, and firm size category.",
      "evidence": [
        {
          "resource": "repo://lib/create/event_study_sample.do#L33-L33",
          "version": "repo-lines-v1:sha256:9d27a1469061465e274e1fd23ce8ba0f574ce9b4f2067f482fba93f5112ed313:"
        }
      ]
    },
    {
      "id": "claim_26d5c3e5fc8e4eb9b5f9623686ea455a",
      "statement": "The target control-to-treated ratio is 10:1, set by local TARGET_N_CONTROL = 10.",
      "evidence": [
        {
          "resource": "repo://lib/create/event_study_sample.do#L27-L27",
          "version": "repo-lines-v1:sha256:314b5b91f77d0d55afad4e0a810e5138711c864475a1a033b82533ea7e7742f0:"
        }
      ]
    },
    {
      "id": "claim_2b1c18d0093f47e9b6cb9f23f3b68dfb",
      "statement": "The random seed for reproducible placebo sampling is SEED = 1391.",
      "evidence": [
        {
          "resource": "repo://lib/create/event_study_sample.do#L28-L28",
          "version": "repo-lines-v1:sha256:badf8668cd1347eaba1caa624996d07cc4d39e26a7304cf1a2ae292198b05056:"
        }
      ]
    },
    {
      "id": "claim_a7ef09804eb243a093199536844353fd",
      "statement": "Placebo change years are assigned by sampling from the empirical t0 distribution (position of change_year within the event window) of treated firms within each stratum, using conditional probabilities n_treated[t] / N_treated.",
      "evidence": [
        {
          "resource": "repo://lib/create/event_study_sample.do#L187-L200",
          "version": "repo-lines-v1:sha256:1913e1f10e0ba713462cdd383d5d221608c9ab68328a9e2f4bf89892a7c45765:"
        }
      ]
    },
    {
      "id": "claim_badd2d49a75246caaa4e3608f547cc5b",
      "statement": "The sampling probability for including a control firm is p = MULTIPLE * N_treated / n_control, where MULTIPLE = TARGET_N_CONTROL / mean(N_treated) ensures the expected number of sampled controls equals 10 per treated firm.",
      "evidence": [
        {
          "resource": "repo://lib/create/event_study_sample.do#L178-L178",
          "version": "repo-lines-v1:sha256:6b7dcec8b04f16c9acb2c35717391d86b3a21b4d9c3828ff58fc79cb9f36401a:"
        }
      ]
    },
    {
      "id": "claim_f4331e8538a34d8d97a254e0bd75d0ac",
      "statement": "Sampling weights for placebo observations are computed as weight = N_treated / n_control to ensure balanced representation in downstream analyses.",
      "evidence": [
        {
          "resource": "repo://lib/create/event_study_sample.do#L184-L184",
          "version": "repo-lines-v1:sha256:e61d6d799e7cf9f02acf40b2634daa25d95de8887bd4183f813a37a1ae3c3f9c:"
        }
      ]
    },
    {
      "id": "claim_a91a42dcddf048808e945f9433fdcb8d",
      "statement": "Control firms must have a CEO spell window (window_start1 to window_end1) that is weakly larger than the treatment event window (window_start to window_end), ensuring sufficient pre- and post-period data coverage.",
      "evidence": [
        {
          "resource": "repo://lib/create/event_study_sample.do#L171-L171",
          "version": "repo-lines-v1:sha256:4ef5fdce6ecb696e96934e23eb9e018adb82dc9de16997dce55deb10cb6541e2:"
        }
      ]
    },
    {
      "id": "claim_a6a779ff1f55431ca9e3b3c36a8156ae",
      "statement": "Balance is verified after assembly by tabulating unweighted and weighted placebo counts, change year distribution, and pre/post window lengths (T1, T2) by the placebo indicator.",
      "evidence": [
        {
          "resource": "repo://lib/create/event_study_sample.do#L231-L240",
          "version": "repo-lines-v1:sha256:a7fc24d7710dc4fb9f11f45ff6dd815594c06abbc7bd473c8fd540587e141cba:"
        }
      ]
    },
    {
      "id": "claim_afd3eaf80bdb44099937d2f6a9453831",
      "statement": "The event study restricts to firms with at most 2 CEOs (max_n_ceo = 2) and requires a minimum of 1 observation per spell (min_T = 1) for manager skill fixed-effect estimation.",
      "evidence": [
        {
          "resource": "repo://lib/create/event_study_sample.do#L32-L32",
          "version": "repo-lines-v1:sha256:1e9d3eb3fa059968db8f80def79ed968e16213ad0ef236c3d4aca6b557962b67:"
        }
      ]
    },
    {
      "id": "claim_8c4017c9f6a94fa4a987d1d8ca4aea80",
      "statement": "Valid sample filters are: full, fnd2non, non2non, small, large, one2one, twos, gap, nogap, gender, nogender, each defined by a condition on CEO spell characteristics (founder status, size, CEO count, age gap, gender change).",
      "evidence": [
