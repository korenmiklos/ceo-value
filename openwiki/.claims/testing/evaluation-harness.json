    {
      "id": "claim_dd7391b1b9f94c2f8eec4282d77a1be3",
      "statement": "The evaluation harness in eval/ tests AI coding agents on their ability to answer questions about Stata .do files by launching a headless opencode process per test case, sending structured prompts with TRUE/FALSE: or NUMERIC: answer prefixes, and scoring responses via regex parsing.",
      "evidence": [
        {
          "resource": "repo://eval/runner.py",
          "version": "repo-file-v1:sha256:de6bda1c0e2144b6ebcc539db90c2ff00935e7335850aced7cb250982df5aaeb"
        },
        {
          "resource": "repo://eval/schemas.py",
          "version": "repo-file-v1:sha256:9fe56974649c8bb6f7fda40d3d3ef58864593ecdffcd9209140ea32e7d5bf0ce"
        }
      ]
    },
    {
      "id": "claim_52feb0faff39411fbb10598a0d6d7c66",
      "statement": "Two question types are supported: true_false (parsed by regex for TRUE/FALSE: prefix) and numeric (parsed by regex for NUMERIC: prefix followed by an integer); partial or non-conforming responses are scored as failures.",
      "evidence": [
        {
          "resource": "repo://eval/runner.py",
          "version": "repo-file-v1:sha256:de6bda1c0e2144b6ebcc539db90c2ff00935e7335850aced7cb250982df5aaeb"
