        }
      ]
    },
    {
      "id": "claim_7990fba68c36408b89bdd9796faf85d6",
      "statement": "Within-firm manager skill is winsorized to the interval [-1, 1] log points, controlled by parameters within_firm_skill_min and within_firm_skill_max.",
