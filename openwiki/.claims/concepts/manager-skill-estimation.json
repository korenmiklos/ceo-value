      "id": "claim_79fe4180612446d38f311457e352d13b",
      "statement": "Manager skill is estimated via a two-stage AKM-style decomposition: (1) within-firm skill computed as mean ROA per firm-manager pair normalized relative to the firm's first CEO, and (2) between-firm skill estimated via two-way fixed effects (reghdfe) absorbing firm frame_id_numeric and manager person_id.",
      "evidence": [
        {
          "resource": "repo://lib/estimate/manager_value.do#L29-L32",
          "version": "repo-lines-v1:sha256:7425dba1bb3b1731fe5067f28b24bf10bc075fb423377e112f220413f97f3928:"
        },
        {
