  "claims": [
    {
      "id": "claim_20de751279c04c5f94867d4637a616eb",
      "statement": "The placebo-controlled event study compares actual CEO transitions to randomly assigned placebo (fake) transitions to separate true managerial effects from spurious correlations arising from small-sample noise and dynamic endogeneity.",
      "evidence": [
        {
          "resource": "repo://doc/2025-09-18-placebo.md",
          "version": "repo-file-v1:sha256:a6490be2b7546f6046f056358d09961a603d522a5a350cf200cffd222c2de01b"
        },
        {
          "resource": "repo://doc/estimation.md",
          "version": "repo-file-v1:sha256:c9100ef0b25489586b1189d5fda7b369e8ec636c7d818330e93f75bfcfbf29c3"
        }
      ]
    },
    {
      "id": "claim_4ad4634627ac425bb9d5688edc655f17",
      "statement": "The core identification is: true variance = Var(treated) − Var(control), and the debiased coefficient β = (Cov(dy, dz | treated) − Cov(dy, dz | control)) / (Var(dz | treated) − Var(dz | control)).",
      "evidence": [
        {
          "resource": "repo://doc/estimation.md#L1-L6",
          "version": "repo-lines-v1:sha256:3d6f1c66d22107b4da5e213b5dcb36ea5ba8b3042bcb52f307613cae5f04fcfe:"
        }
      ]
    },
    {
      "id": "claim_93fce71932b844c1beac4ab7055d43da",
      "statement": "Placebo transitions are constructed via stratified matching on cohort, sector, and max size, with timing sampled from the empirical t0 distribution of actual changes, targeting 10 control firms per treated firm.",
      "evidence": [
        {
          "resource": "repo://lib/create/event_study_sample.do",
          "version": "repo-file-v1:sha256:96de0c99a8e1545f402e88fc8fca35d844a7a01737774a348b82fc8523035016"
        }
      ]
    },
    {
      "id": "claim_674242e1c8974ebe8541f6dff6f39c27",
      "statement": "The estimation pipeline: setup_event_study.do merges placebo data with manager skill estimates and constructs event-time indicators, then event_study.do calls xt2denoise to compute naive and debiased beta coefficients and outcome variances by event time.",
      "evidence": [
        {
          "resource": "repo://lib/estimate/event_study.do",
          "version": "repo-file-v1:sha256:3873eb2e90e44ca748eda3ca121ac58bdc8db68af3019d46f831c358fb8585ce"
        },
        {
          "resource": "repo://lib/estimate/setup_event_study.do",
          "version": "repo-file-v1:sha256:cc0721ee1545b9385319b729cac2ddf97c9b4f584eb28864410c0ad68b5f60bc"
        }
      ]
    },
    {
      "id": "claim_4925c4b7ddac44ab88655a7a69a79a82",
      "statement": "xt2denoise computes second moments (dy², dz², dydz) after removing group fixed effects and event-time × treatment-group means, then estimates naive (treated-only) and debiased (treated-minus-placebo) covariances and variances by event time.",
      "evidence": [
        {
          "resource": "repo://doc/estimation.md#L52-L71",
          "version": "repo-lines-v1:sha256:3704d6d225dd11866d5fb2cac415a18848c640d4cfe54885a1dbacb367724a1c:"
        }
      ]
    },
    {
      "id": "claim_f130b459c07240e5a4a1b11aafb5859e",
      "statement": "The ATET variant (event_study_atet.do) collapses event times into pre and post periods, computing a single ATET = β_post − β_pre parameter using xt2denoise with baseline(atet).",
      "evidence": [
        {
          "resource": "repo://lib/estimate/event_study_atet.do",
          "version": "repo-file-v1:sha256:2ac2a4bb8a3c3bab33aea7ce4ffccfab3a6b53ab7de28da4751f372d6b49089a"
        }
      ]
    },
    {
      "id": "claim_86b1ff71056e42ae867557987f0ad463",
      "statement": "The Monte Carlo simulation (montecarlo.do) validates the methodology using a known DGP with 10,000 CEO changes, AR(1) TFP process (ρ=0.97), CEO ability σ_z=0.1, and 9:1 placebo-to-treated ratio.",
      "evidence": [
        {
          "resource": "repo://lib/create/montecarlo.do",
          "version": "repo-file-v1:sha256:5deaa2da9c9cefa5d2e8e1bca094904eb754b1eda065c3a68404f2b02eb6596a"
        }
      ]
    },
    {
      "id": "claim_08be4b69aed64f8682313751acea01fa",
      "statement": "The variance decomposition script (xt2var.do) implements the placebo-controlled methodology manually without xt2denoise, using an iterative fixed-point algorithm to estimate excess variance ratios and reghdfe for event-time coefficients.",
      "evidence": [
        {
          "resource": "repo://lib/estimate/xt2var.do",
